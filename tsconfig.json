// en-GB: Configures TypeScript compilation so this workspace keeps consistent strict type checking.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "vitest/globals", "@playwright/test"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "eslint.config.mjs",
    "playwright.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "generated"]
}
