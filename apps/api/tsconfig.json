// en-GB: Configures TypeScript compilation so this workspace keeps consistent strict type checking.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "../../dist/api",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
