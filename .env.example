# en-GB: Documents supported environment variables so local and deployed configuration stays explicit.
DATABASE_URL="postgresql://shiftflow:replace-with-a-local-password@localhost:5432/shiftflow?schema=public"
POSTGRES_PASSWORD="replace-with-a-local-password"
API_INSTANCE_COUNT=1
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_STORE=memory
REDIS_CONNECTION="localhost:6379,abortConnect=false"
REDIS_INSTANCE_NAME="shiftflow:local:"
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_MAX_ATTEMPTS=5
JWT_SECRET="replace-with-a-local-secret"
JWT_ACCESS_SECRET="replace-with-a-local-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="shiftflow"
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGIN="http://localhost:3000"
REQUIRE_ORIGIN_ON_UNSAFE_REQUESTS=false
TRUST_PROXY=false
# The ASP.NET Core host accepts forwarded headers only from these literal proxy IPs.
TRUSTED_PROXY_IPS="127.0.0.1,::1"
# Production containers must persist data-protection keys on a protected shared path.
DATA_PROTECTION_KEYS_PATH=""
# Enables an internal, edge-inaccessible data-protection restart probe only in disposable runtime validation.
ENABLE_INTERNAL_RUNTIME_PROBES="false"
# Web and API URLs must share a protocol and hostname; production URLs must use HTTPS.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_ALLOW_INSECURE_LOOPBACK="false"
