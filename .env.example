# en-GB: Documents supported environment variables so local and deployed configuration stays explicit.
DATABASE_URL="postgresql://shiftflow:replace-with-a-local-password@localhost:5432/shiftflow?schema=public"
POSTGRES_PASSWORD="replace-with-a-local-password"
API_INSTANCE_COUNT=1
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_STORE=memory
REDIS_CONNECTION="localhost:6379,abortConnect=false"
REDIS_INSTANCE_NAME="shiftflow:local:"
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
# This lower budget protects direct demo/portfolio access.
# Password login remains behind the global emergency ceiling.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# These retained names configure the failure-count window and backoff threshold; they do not reject a correct password.
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_MAX_ATTEMPTS=5
# Development defaults to direct demo access; production always requires authentication.
AUTH_MODE="demo"
AUTH_DEMO_EMAIL="demo@shiftflow.local"
# Public portfolio access is opt-in and must target a synthetic, restricted identity.
PORTFOLIO_ACCESS_ENABLED="false"
PORTFOLIO_ACCESS_EMAIL="observador.executivo@shiftflow.local"
JWT_SECRET="replace-with-a-local-secret"
JWT_ACCESS_SECRET="replace-with-a-local-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="shiftflow"
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGIN="http://localhost:3000"
REQUIRE_ORIGIN_ON_UNSAFE_REQUESTS=false
# Render production services must set this explicitly. Keep false unless the ingress proxy IPs are verified.
TRUST_PROXY=false
# The ASP.NET Core host accepts forwarded headers only from these literal proxy IPs.
TRUSTED_PROXY_IPS="127.0.0.1,::1"
# Production containers must persist data-protection keys on a protected shared path.
DATA_PROTECTION_KEYS_PATH=""
# Enables an internal, edge-inaccessible data-protection restart probe only in disposable runtime validation.
ENABLE_INTERNAL_RUNTIME_PROBES="false"
# Web and API URLs must share a protocol and hostname; production URLs must use HTTPS.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_ALLOW_INSECURE_LOOPBACK="false"
NEXT_PUBLIC_PORTFOLIO_ACCESS="false"
NEXT_PUBLIC_PORTFOLIO_EMAIL="observador.executivo@shiftflow.local"
